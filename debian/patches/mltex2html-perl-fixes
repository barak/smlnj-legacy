-     s|~?\\begin{($ENV2)}{($PARAM)}{($PARAM)}|&beginenv($1,$2,$3)|oge;
-     s|~?\\end{($PARAM)}|&endenv($1)|oge;
+     s|~?\\begin\{($ENV0)\}|&beginenv($1)|oge;
