+     s|\\begin\{tabular\}\{($PARAM)\}|&begintab($1,"")|oge;
+     s|\\end\{tabular\}|&endtab()|oge;
      
-     s|\\begin{Table}{($PARAM)}{($PARAM)}|&begintab($1,$2)|oge;
