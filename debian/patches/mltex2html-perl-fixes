 ############################################################################
+use lib '.';
 require "mltex.thm";
 
 ############################################################################
@@ -1266,7 +1267,7 @@ sub processSection
 
      # Verbatim mode handling
      if ($MODE eq "verbatim")
-     {  if (s|\\end{verbatim}|$ENDPRE|) { leaveMode("verbatim"); }
+     {  if (s|\\end\{verbatim\}|$ENDPRE|) { leaveMode("verbatim"); }
         else 
         { s/</&lt;/g;
           s/>/&gt;/g;
