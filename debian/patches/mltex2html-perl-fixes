From: James McCoy <jamessan@debian.org>
Date: Tue, 13 Sep 2016 21:39:39 -0400
Subject: mltex2html-perl-fixes

Fix FTBFS when '.' is not part of @INC and escape literal '{' in regex

Expanded by gregor herrmann <gregoa@debian.org> on Tue, 8 Aug 2017 11:46:37 -0400

Fix "FTBFS: Unescaped left brace in regex is illegal here in regex":
extend debian/patches/mltex2html-perl-fixes to escape literal opening
braces in mltex2html script.
See https://bugs.debian.org/871335
---
 MLRISC/Doc/html/mltex2html | 81 +++++++++++++++++++++++-----------------------
 1 file changed, 41 insertions(+), 40 deletions(-)

diff --git a/MLRISC/Doc/html/mltex2html b/MLRISC/Doc/html/mltex2html
index 24d393f..ff8b48a 100755
--- a/MLRISC/Doc/html/mltex2html
+++ b/MLRISC/Doc/html/mltex2html
@@ -844,10 +844,10 @@ sub math
    # subscript/superscripts
    $math =~ s|_([^{])|<sub>\1</sub>|g;
    $math =~ s|\^([^{])|<sup>\1</sup>|g;
-   $math =~ s|_{($PARAM)}|<sub>\1</sub>|g;
-   $math =~ s|^{($PARAM)}|<sup>\1</sup>|g;
-   $math =~ s|\\sb{($PARAM)}|<sub>\1</sub>|g;
-   $math =~ s|\\sp{($PARAM)}|<sup>\1</sup>|g;
+   $math =~ s|_\{($PARAM)}|<sub>\1</sub>|g;
+   $math =~ s|^\{($PARAM)}|<sup>\1</sup>|g;
+   $math =~ s|\\sb\{($PARAM)}|<sub>\1</sub>|g;
+   $math =~ s|\\sp\{($PARAM)}|<sup>\1</sup>|g;
 
    # other stuff 
    $math =~ s|\\edge\{($PARAM)\}|&rarr<sub>\1</sub>|g;
@@ -1000,6 +1000,7 @@ newcommand("tableofcontents", 0, \&tableofcontents);
 # Import style file
