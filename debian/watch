# Upstream ships many separate tarballs, so uscan downloads only
# config.tgz to detect the version, and debian/mkorig then fetches
# the rest and assembles the real orig tarball.  (The 20xx.y releases
# are the new LLVM-based development series; Debian follows the
# 110.99.x "legacy" series.)
Version: 5

Source: https://www.smlnj.org/dist/working/
Matching-Pattern: (110\.[\d.]+)/index\.html
Download-URL-Mangle: s/index\.html$/config.tgz/
Filename-Mangle: s/.*?(110[\d.]+)\/index\.html$/smlnj-config-$1.tgz/
Compression: gzip
Update-Script: debian/mkorig
